# Nakili faili hili kuwa `.env` kisha weka thamani zako.

APP_ENV=development
APP_PORT=8000
# Saa za ofisi (ripoti za siku, dashboard)
TIMEZONE=Africa/Dar_es_Salaam

# ---------------- Database (PostgreSQL) - inaundwa yenyewe kama haipo
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=123456
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=logistic_db
TEST_DATABASE_NAME=logistic_db_test

# ---------------- JWT (badilisha SECRET_KEY production)
# Tengeneza: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------- Usalama
# Tovuti za web app zinazoruhusiwa (zitenganishe kwa koma). "*" = zote (development tu)
CORS_ORIGINS=*
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# true kama API iko nyuma ya nginx yenye HTTPS (tazama deploy/nginx.conf)
BEHIND_PROXY=false
FORCE_HTTPS=false
# /docs - weka false production
API_DOCS=true

# ---------------- Wewe: msimamizi wa kwanza wa mfumo mzima (platform admin - admin panel yako)
# Anaundwa mara moja tu kama hakuna platform admin yeyote. Anaingia kwa POST /api/platform/login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=

# ---------------- SaaS (kampuni za usafirishaji ni wateja wako)
PLATFORM_NAME=Logistic Cloud
# Domain kuu: kila kampuni inafunguka kwa <code>.<PLATFORM_DOMAIN> (mf. ymg.logistic.co.tz).
# Kampuni yenye domain yake (mf. ymg.co.tz) inawekwa kwenye admin panel (companies -> domain).
PLATFORM_DOMAIN=
PLATFORM_SUPPORT_PHONE=
PLATFORM_SUPPORT_EMAIL=
# Jinsi kampuni zinavyokulipa (inaonekana kwenye ukurasa wao wa Subscription)
PLATFORM_PAYMENT_INFO=M-Pesa Lipa No. 000000 (JINA LAKO)\nCRDB 0150000000000 (JINA LAKO)
# Jina la SMS (sender) la vikumbusho vya subscription kwa kampuni (kupitia akaunti yako ya SMS hapo chini)
PLATFORM_SMS_SOURCE=
# Kampuni zinajisajili zenyewe (ukurasa wa "Fungua akaunti") na kupata majaribio ya siku TRIAL_DAYS
SELF_SIGNUP_ENABLED=true
# Kampuni iliyojisajili yenyewe inasubiri uithibitishe kwenye /#/super-admin (majaribio yanaanza ukithibitisha)
SIGNUP_REQUIRES_APPROVAL=true
TRIAL_DAYS=14
# Baada ya subscription kuisha: siku za neema (kazi zote), kisha mfumo ni wa kusoma tu hadi walipie
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_REMIND_DAYS=7,3,1
# Kampuni isiyo na FastHub yake inatumia akaunti yako ya SMS (SMS_CLIENT_ID/SECRET). false = hapana.
PLATFORM_SMS_FOR_TENANTS=true
# Kuhamisha data ya TransportCore (database ya zamani): unda kampuni yenye code hii kwanza, kisha data yote
# isiyo na kampuni inapewa kampuni hiyo server ikiwaka.
DEFAULT_COMPANY_SLUG=
# Development tu: kampuni ya localhost (bila domain wala X-Company)
DEV_COMPANY_SLUG=

# ---------------- Mafaili (picha na PDF)
# Windows mfano: C:\Users\user\Documents\Logistic\    Linux mfano: /var/lib/logistic/
# (kila kampuni inapata folder lake ndani: <company_id>/Images, /Report ...)
FILES_DIR=
LIBREOFFICE_PATH=

# ---------------- Backup (database + picha + PDF) kila siku
BACKUP_ENABLED=true
# Tupu = FILES_DIR/_backup  (backup ni ya database nzima - inasimamiwa na wewe kwenye /api/platform/server/backups)
BACKUP_DIR=
BACKUP_HOUR=2
BACKUP_KEEP=14
# Nakala ya pili: disk ya nje au folder la Google Drive/OneDrive (inashauriwa sana)
BACKUP_MIRROR_DIR=
# Windows mfano: C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql

# ---------------- Biashara: THAMANI ZA KAWAIDA
# Kila kampuni inaweza kuweka zake (app -> Mipangilio -> Kampuni yetu). Ikiacha tupu, hizi zinatumika.
DAYS_TO_CHARGE=7
STORAGE_CHARGE_USD=3.0
IMAGE_RETENTION_DAYS=30
COMPANY_ORIGIN=Guangzhou China

# ---------------- SMS (FastHub) - akaunti YAKO (vikumbusho vya subscription + kampuni zisizo na FastHub yao)
SMS_SOURCE_NAME=LOGISTIC
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=
SMS_API=https://bulksms.fasthub.co.tz/api/sms/send
SMS_CODING=GSM7
# SMS zinatumwa zenyewe (mzigo ukipokelewa, ukisafirishwa, ukifika stoo). false = kutuma kwa mkono.
SMS_AUTO_SEND=true

SCHEDULER_ENABLED=true

# ---------------- Ufuatiliaji wa mzigo kwa mteja (bila kuingia)
PUBLIC_TRACKING=true
# (Kiungo cha kufuatilia kwenye SMS kinatengenezwa chenyewe kwa domain ya kila kampuni)

# ---------------- Vikumbusho vya SMS (madeni na stoo)
REMINDERS_ENABLED=true
REMINDER_HOUR=9
REMINDER_EVERY_DAYS=7
STORAGE_WARN_DAYS=2
# Popup kwenye app kwa mizigo iliyokaa stoo zaidi ya DAYS_TO_CHARGE - inarudiwa kila siku hizi
STORAGE_ALERT_EVERY_DAYS=7
# Ujumbe kwa wateja wengi: idadi ya juu kwa mara moja
BROADCAST_MAX=5000
# SMS za ankara: bidhaa zaidi ya hizi zinajumlishwa kwenye mstari mmoja
SMS_ITEMS_MAX=15

# Ripoti za kufika kwa SMS (DLR). Mpe FastHub URL hii: https://SERVER/api/public/sms-dlr/<SMS_DLR_TOKEN>
# Weka maneno marefu ya siri (mf. herufi 32). Tupu = imezimwa.
SMS_DLR_TOKEN=
SMS_DLR_UNIQUE_REFERENCE=true

# WhatsApp (Meta) webhook ya hali ya ujumbe: https://SERVER/api/public/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Salio la SMS: onyo likishuka chini ya hiki. SMS_BALANCE_API = URL ya FastHub ya salio (hiari)
SMS_LOW_BALANCE=300
SMS_BALANCE_API=

# Siku za kawaida za safari (ETA) box likifungwa
ETA_AIR_DAYS=10
ETA_SEA_DAYS=45
# Namba za simu zote: +255XXXXXXXXX (mf. +255712345678). SMS_MSISDN_PLUS=false kutuma 255712345678 kwa gateway
PHONE_COUNTRY_CODE=255
SMS_MSISDN_PLUS=true

# ---------------- WhatsApp Business Cloud API (Meta)
# Kila kampuni inaweka akaunti yake ya WhatsApp kwenye app; hizi hapa hazitumiwi na kampuni.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_DOC_TEMPLATE=
WHATSAPP_IMAGE_TEMPLATE=
WHATSAPP_LANG=sw
WHATSAPP_COUNTRY_CODE=255

# ---------------- Tahadhari za server
ALERT_PHONES=
ALERT_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_DISK_MIN_GB=2
ALERT_BACKUP_MAX_HOURS=36

# ------------------------------------------------ Usalama na fedha
# Kikomo cha mkopo cha kawaida (TSh) kwa mteja asiye na kikomo chake. -1 = hakuna kikomo, 0 = hakuna mkopo.
DEFAULT_CREDIT_LIMIT=-1
# Uthibitisho wa hatua mbili (code ya SMS) kwa watumiaji waliowashiwa. false = zima kwa wote (dharura).
TWO_FACTOR_ENABLED=true
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45
